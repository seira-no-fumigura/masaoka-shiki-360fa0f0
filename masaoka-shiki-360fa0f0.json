   "poems": [],
   "notes": [],
   "lb": [],
   "form": "prose"
  },
  {
   "id": "masaoka-shiki-360fa0f0-000047",
   "pid": "",
   "pages": [],
   "no": 47,
   "vol": "高尾紀行",
   "kotobagaki": "",
   "author": "",
   "text": "高尾山を攀ぢ行けば都人に珍らしき山路の物凄き景色身にしみて面白く下闇にきらつく紅葉萎みて散りかゝりたるが中にまだ半ば青きもたのもし。",
   "sachu": "",
   "poems": [],
   "notes": [],
   "lb": [],
   "form": "prose"
  },
  {
   "id": "masaoka-shiki-360fa0f0-000048",
   "pid": "",
   "pages": [],
   "no": 48,
   "vol": "高尾紀行",
   "kotobagaki": "",
   "author": "",
   "text": "木の間より見下す八王子の人家甍を竝べて鱗の如し。",
   "sachu": "",
   "poems": [],
   "notes": [],
   "lb": [],
   "form": "prose"
  },
