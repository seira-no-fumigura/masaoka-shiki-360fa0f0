   "pages": [],
   "no": 32,
   "vol": "高尾紀行",
   "kotobagaki": "",
   "author": "",
   "text": "暫くは汽車に膝栗毛を休め小春日のさしこむ窓に顏さしつけて富士の姿を眺めつゝ",
   "sachu": "",
   "poems": [],
