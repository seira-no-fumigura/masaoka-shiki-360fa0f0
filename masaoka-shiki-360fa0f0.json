   "no": 3,
   "vol": "鎌倉一見の記",
   "kotobagaki": "",
   "author": "",
   "text": "藤澤の旅籠屋を敲いて一夜の旅枕と定む。朝とく目さむれば裏の藪に鳴く鶯の一聲二聲もうれしく、",
   "sachu": "",
   "poems": [],
   "notes": [],
   "lb": [],
   "form": "prose"
  },
  {
   "id": "masaoka-shiki-360fa0f0-000004",
   "pid": "",
   "pages": [],
   "no": 4,
   "vol": "鎌倉一見の記",
   "kotobagaki": "",
   "author": "",
   "text": "鶯やおもて通りは馬の鈴",
   "sachu": "",
   "poems": [],
   "notes": [],
   "lb": [],
   "form": "prose"
  },
  {
   "id": "masaoka-shiki-360fa0f0-000005",
   "pid": "",
   "pages": [],
   "no": 5,
   "vol": "鎌倉一見の記",
   "kotobagaki": "",
   "author": "",
   "text": "鶯や左の耳は馬の鈴",
   "sachu": "",
   "poems": [],
   "notes": [],
